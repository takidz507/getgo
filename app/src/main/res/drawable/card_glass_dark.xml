<?xml version="1.0" encoding="utf-8"?>
<!-- v2.2 layered glass (dark): diagonal translucent gradient + a bright
     top-edge stroke, so the card reads as glass instead of a flat tint.
     Android has no native Apple Liquid Glass; this is a lookalike, and
     it deliberately does NOT blur content behind the card (cards scroll
     over a solid background, so a backdrop blur would be fake work). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#663E3E3E"
                android:endColor="#80262626"
                android:type="linear" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <stroke android:width="1dp" android:color="#66FFFFFF" />
            <corners android:radius="24dp" />
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
</layer-list>
