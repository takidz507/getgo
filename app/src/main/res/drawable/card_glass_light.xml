<?xml version="1.0" encoding="utf-8"?>
<!-- v2.2 layered glass (light): diagonal translucent gradient + a bright
     top-edge stroke. Android lookalike only, not Apple Liquid Glass. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#E6FFFFFF"
                android:endColor="#B3FFFFFF"
                android:type="linear" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <stroke android:width="1dp" android:color="#99FFFFFF" />
            <corners android:radius="24dp" />
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
</layer-list>
